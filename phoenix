name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'phoenixanand'
        required: true
        default: 'phoenixanand'
      agent_description:
        description: 'phoenixanand'
        required: true
        default: 'finder AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      # 1️⃣ Checkout the repository
      - name: Checkout repo
        uses: actions/checkout@v3

      # 2️⃣ Set up Node.js (use the latest LTS you prefer)
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      # 3️⃣ Install the ClawHub skill (optional – keep if you need it)
      - name: Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity

      # 4️⃣ Install script dependencies
      - name: Install script dependencies
        run: npm install
        working-directory: ./scripts

      # 5️⃣ Create a new Ethereum identity
      - name: Step 2 - Create new Ethereum Identity
        run: node createNewEthereumIdentity.js
        working-directory: ./scripts

      # 6️⃣ Link the human to the agent
      - name: Step 3 - Link Human to Agent
        run: |
          node manualLinkHumanToAgent.js \
            --challenge '{"name": "phoenixanand", "description": "phoenixanand AI Agent"}'
        working-directory: ./scripts
